<Project Sdk="Microsoft.NET.Sdk">
    <!-- Models and the API client, free of UI so they can be unit tested on any OS (dotnet test). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Flock.Kit</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <UseWPF>false</UseWPF>
        <UseWindowsForms>false</UseWindowsForms>
    </PropertyGroup>
    <ItemGroup>
        <!-- Translations: Strings.cs.resx and Strings.es.resx build into satellite assemblies (cs\, es\). The build generates
             the internal Strings class from Strings.resx into obj\, so no generated code is committed or needs an IDE tool. -->
        <EmbeddedResource Update="Strings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Flock.Kit" StronglyTypedClassName="Strings"
                          StronglyTypedManifestPrefix="Flock.Kit" StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs"/>
    </ItemGroup>
</Project>
